# HavenCraft Home Improvement - Environment Configuration
# Copy this file to .env.local to configure real production integrations.

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://www.havencrafthome.com

# --- Google Analytics & Tag Manager (Optional) ---
# Replace with your verified GTM Container ID or GA4 Measurement ID when approved
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# --- CRM & Outgoing Lead Webhook (Optional) ---
# If configured, every valid lead submission will automatically dispatch a secure POST payload to your CRM
LEAD_NOTIFICATION_WEBHOOK_URL=

# --- Email Notifications (Optional) ---
# Configure if using Resend / SendGrid / Postmark for automated customer confirmation and internal crew alerts
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=contact@havencrafthome.com

# --- Google Maps Platform API Key (Optional) ---
# For dynamic street-view or interactive routing beyond the default responsive embed
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
